# Copie este arquivo para ".env" e preencha. NUNCA faça commit do .env!

# "gemini" usa a API do Google Gemini; "simulado" usa regras por palavras-chave
# (sem IA, sem custo) — útil para testar o pipeline sem chave de API.
PROVEDOR_LLM=gemini

# Crie sua chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-sua-chave-aqui
GEMINI_MODELO=gemini-3.8-flash
# Modelo de embeddings usado na busca do agente analista
GEMINI_MODELO_EMBEDDING=gemini-embedding-001

# Desliga o "raciocínio" interno do Gemini Flash (mais rápido e barato).
# Mude para 0 se trocar para um modelo que não aceita essa opção.
GEMINI_DESATIVAR_RACIOCINIO=1

# Modelo usado quando o principal está sobrecarregado (erro 503) ou demora demais.
# Deixe vazio para desligar.
GEMINI_MODELO_RESERVA=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SEGUNDOS=60

# Controle de custo/tempo
TAMANHO_LOTE=10
MAX_TENTATIVAS=3
MAX_AVALIACOES=500
PAUSA_ENTRE_CHAMADAS=6
# Máximo de passos do agente analista por pergunta
AGENTE_MAX_PASSOS=6

# Preços (US$ por 1 milhão de tokens) usados só para ESTIMAR custo no plano pago.
# gemini-3.8-flash até 31/12/2026; a partir de 01/01/2027: 1.50 e 7.50.
# Confira os valores atuais em https://ai.google.dev/gemini-api/docs/pricing
PRECO_ENTRADA_1M=0.75
PRECO_SAIDA_1M=3.75

# Acesso ao app. Sem login configurado o app fica bloqueado.
# No seu computador, LOGIN_DESATIVADO=1 libera o uso sem senha.
# No app publicado, use login com Google ou SENHA_APP (veja docs/deploy.md).
LOGIN_DESATIVADO=1
# SENHA_APP=
