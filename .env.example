# Copie este arquivo para ".env" e preencha. NUNCA faça commit do .env!

# "gemini" usa a API do Google Gemini; "simulado" usa regras por palavras-chave
# (sem IA, sem custo) — útil para testar o pipeline sem chave de API.
PROVEDOR_LLM=gemini

# Crie sua chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-sua-chave-aqui
GEMINI_MODELO=gemini-3.8-flash

# Desliga o "raciocínio" interno do Gemini Flash (mais rápido e barato).
# Mude para 0 se trocar para um modelo que não aceita essa opção.
GEMINI_DESATIVAR_RACIOCINIO=1

# Controle de custo/tempo
TAMANHO_LOTE=10
MAX_TENTATIVAS=3
MAX_AVALIACOES=500
PAUSA_ENTRE_CHAMADAS=6

# Preços (US$ por 1 milhão de tokens) usados só para ESTIMAR custo no plano pago.
# Confira os valores atuais em https://ai.google.dev/pricing
PRECO_ENTRADA_1M=0.30
PRECO_SAIDA_1M=2.50
