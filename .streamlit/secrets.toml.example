# Modelo dos Secrets do Feedback Radar. NÃO coloque valores reais neste arquivo.
#
# - No Streamlit Community Cloud: copie o conteúdo para Settings > Secrets do app.
# - No seu computador (opcional): copie para .streamlit/secrets.toml
#   (esse arquivo está no .gitignore e nunca deve ir para o GitHub).
# Passo a passo completo em docs/deploy.md.

# ---------- IA ----------
GEMINI_API_KEY = "cole-sua-chave-aqui"
GEMINI_MODELO = "gemini-3.5-flash-lite"
PROVEDOR_LLM = "gemini"
# Teto de avaliações por execução (protege a cota da chave)
MAX_AVALIACOES = "200"

# ---------- Acesso ----------
# E-mails que podem entrar com login Google, separados por vírgula.
# Obrigatório quando a seção [auth] existe: sem a lista, ninguém entra.
EMAILS_PERMITIDOS = "integrante1@gmail.com, dono.do.negocio@gmail.com"

# Alternativa sem Google: senha simples. Só é usada se a seção [auth] abaixo
# NÃO existir. Use uma senha longa e não reaproveite senhas pessoais.
# SENHA_APP = "troque-por-uma-senha-longa"

# ---------- Login com Google (OIDC, st.login) ----------
# Apague esta seção inteira se for usar só SENHA_APP.
[auth]
# Endereço do app + /oauth2callback (localmente: http://localhost:8501/oauth2callback)
redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"
# Texto aleatório e longo, ex.: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "gere-um-texto-aleatorio-longo"
# Credenciais do "ID do cliente OAuth" criado no Google Cloud Console
client_id = "000000000000-xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
